        "subject": "=Registration Confirmed - {{ $json['Event Name'] }} ({{$json['Participant ID']}})",
        "message": "=<p>Dear {{ $json['Full Name'] }} ,</p><p>Thank you for registering for <strong>{{ $json['Event Name'] }}</strong>. We are pleased to confirm that your registration has been successfully received and recorded.</p><p><strong>Your Participant ID:</strong> {{$json['Participant ID']}}<br/><strong>Event:</strong> {{ $json['Event Name']  }}<br/><strong>Registered On:</strong> {{$json['Registration Time']}}</p><p>Please keep this Participant ID safe, as it will be required for check-in and further communications regarding the event, including your QR code entry pass.</p><p>We look forward to your participation.</p><p>Best regards,<br/>Event Management Team</p>",
        "options": {
          "appendAttribution": false
        }
