    {
      "parameters": {
        "jsCode": "// Normalize error details from whichever node failed, for consistent logging\nconst items = $input.all();\nconst now = new Date().toISOString();\n\nreturn items.map((item) => {\n  const err = item.json.error || {};\n  return {\n    json: {\n      Timestamp: now,\n      WorkflowName: 'Participant Registration',\n      FailedNode: err.node ? err.node.name : ($workflow.name || 'Unknown'),\n      ErrorMessage: err.message || item.json.message || 'Unknown error occurred',\n      RawData: JSON.stringify(item.json).slice(0, 500)\n    }\n  };\n});"
      },
      "id": "42fd56c6-6a08-49fb-a4a9-ccb62d0ba1e2",
      "name": "Format Error Details",
